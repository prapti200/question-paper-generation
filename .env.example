# Google Gemini API Key (keep secret, never exposed to client)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Fast multimodal model for scanning documents and detecting chapters & science diagrams
SCAN_MODEL=gemini-2.5-flash

# Fast model for Topic MCQ generation
MCQ_MODEL=gemini-2.5-flash

# Strong model for generating the final comprehensive Question Paper (e.g. gemini-2.5-flash or gemini-1.5-pro)
FINAL_MODEL=gemini-2.5-flash
